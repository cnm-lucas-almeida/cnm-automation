# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# banco local de autenticação (estado local, não vai no commit)
/data/

# logs e saídas de scripts (não são código-fonte)
/logs/
scripts/logs/
*.csv
scripts/uncategorized_tickets.json
scripts/omie/erro_retorno.html

# typescript
*.tsbuildinfo
next-env.d.ts

.claude/

*.xlsx
docs/RH/Extrato Unimed Mês 07 - 26.pdf

# planilhas/dumps reais de folha (CPF, salário, empréstimo) usados só pra
# validação local — os .md de referência em docs/RH/ continuam versionados
docs/RH/*.json

# script de debug pontual (Secullum), não é código do produto
/_scratch_batida_raw.js

# scripts descartáveis de consulta/validação de banco e dumps que eles geram —
# a pasta scripts/db/ segue versionada pra scripts que valha a pena guardar,
# mas o que tem prefixo _scratch_ (ou é backup de tabela) é lixo de sessão
scripts/db/_scratch_*
scripts/db/backup_*
